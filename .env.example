# DeepSeek Harness Federation Docker Environment Configuration

# DeepSeek API credentials
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Shared Federation secret token (used for Pod authentication against Hub)
DSH_FEDERATION_TOKEN=federation-secret-token-change-me

# Optional: Hub federation WS listener (defaults: 0.0.0.0:3088)
# DSH_FEDERATION_HOST=0.0.0.0
# DSH_FEDERATION_PORT=3088

# Optional: Git commit stamped into client build metadata (defaults: unknown)
# DSH_CLIENT_COMMIT_HASH=
